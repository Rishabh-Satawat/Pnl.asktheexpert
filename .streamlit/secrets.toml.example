# .streamlit/secrets.toml — Streamlit Secrets (for Streamlit Cloud or local)
# NEVER commit this file to git. Add it to .gitignore.
# For local dev: create this file and fill in your real values.
# For Streamlit Cloud: paste these values in Dashboard -> App -> Settings -> Secrets.

# Gemini Vision API (required for screenshot OCR)
GEMINI_API_KEY = "your_gemini_api_key_here"

# App access password (optional — locks the app when deployed publicly)
APP_ACCESS_PASSWORD = ""

# Supabase (required for cloud persistence)
SUPABASE_URL = "https://your_project_ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "your_service_role_key_here"

# Dhan API (optional — secondary LTP cross-reference)
DHAN_CLIENT_ID = ""
DHAN_ACCESS_TOKEN = ""
